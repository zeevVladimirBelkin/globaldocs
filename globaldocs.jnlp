<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE jnlp PUBLIC "-//Sun Microsystems, Inc.//DTD JNLP 1.5//EN" "http://www.netbeans.org/jnlp/DTD/jnlp.dtd">
<!-- Archive preparation 2026-10-15: replaced the private local codebase with a placeholder. -->
<jnlp codebase="https://example.invalid/globaldocs/" href="globaldocs.jnlp">
  <information>
    <title>Global Javadoc Viewer</title>
    <vendor>Zeev Belkin</vendor>
    <homepage href="http://globaldocs.zeevbelkin.com"/>
    <description>default</description>
    <icon href="default"/>
    <offline-allowed/>
    <shortcut online="true"/>
  </information>
  <resources>
    <j2se version="1.5+"/>
    <jar href="dist/globaldocs.jar"/>
  </resources>
  <application-desc main-class="globaldocs.MainFrame"/>
</jnlp>
