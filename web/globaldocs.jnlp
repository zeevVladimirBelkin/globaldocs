<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE jnlp PUBLIC "-//Sun Microsystems, Inc.//DTD JNLP 1.5//EN" "http://www.netbeans.org/jnlp/DTD/jnlp.dtd">
<jnlp codebase="$$codebase" href="globaldocs.jnlp">
  <information>
    <title>Global Javadoc Viewer</title>
    <vendor>Zeev Belkin</vendor>
    <homepage href="http://globaldocs.zeevbelkin.com"/>
    <description>default</description>
    <icon href="default"/>
    <offline-allowed/>
    <shortcut online="true"/>
  </information>
  <resources locale="" os="">
    <j2se version="1.5+"/>
    <jar download="eager" href="dist/globaldocs.jar" version=""/>
  </resources>
  <application-desc main-class="globaldocs.MainFrame"/>
</jnlp>
