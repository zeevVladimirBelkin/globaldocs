# Archive preparation 2026-10-15: removed machine-specific Dev-C++ search paths.
# Project: Project1
# Makefile created by Dev-C++ 4.9.9.2

CPP  = g++.exe
CC   = gcc.exe
WINDRES = windres.exe
RES  = run_private.res
OBJ  = run.o $(RES)
LINKOBJ  = run.o $(RES)
LIBS = -mwindows -lole32 -luuid -s
INCS =
CXXINCS =
BIN  = run.exe
CXXFLAGS = $(CXXINCS)   -O1
CFLAGS = $(INCS)   -O1
RM = rm -f

.PHONY: all all-before all-after clean clean-custom

all: all-before run.exe all-after


clean: clean-custom
	${RM} $(OBJ) $(BIN)

$(BIN): $(OBJ)
	$(CC) $(LINKOBJ) -o "run.exe" $(LIBS)

run.o: run.cpp
	$(CC) -c run.cpp -o run.o $(CFLAGS)

run_private.res: run_private.rc 
	$(WINDRES) -i run_private.rc --input-format=rc -o run_private.res -O coff 
